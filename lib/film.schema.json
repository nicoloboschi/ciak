{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nicoloboschi/ciak/lib/film.schema.json",
  "title": "ciak film",
  "description": "A launch video as a list of scenes. Each scene lasts as long as its narration (or its recording); captions, music, transitions and audio levels are automatic. Rich text fields accept *muted words* (grey) and [accent words] (accent color).",
  "type": "object",
  "required": [
    "scenes"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "description": "The narrator (local Kokoro voice, or your own voice from ciak voice add; macOS say if it fails).",
      "properties": {
        "name": {
          "type": "string",
          "description": "A voice from ciak voice list (your own, cloned), or a Kokoro voice, e.g. af_heart, af_bella, am_michael, bf_emma. Default af_heart."
        },
        "speed": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.5,
          "description": "Speaking speed, default 1."
        },
        "pronounce": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "How to say words, e.g. {\"Memlake\": \"Mem-lake\"}. Only the voice changes; captions keep the spelling."
        }
      }
    },
    "music": {
      "description": "false for no music; a file path; or {file, volume}. Default: generated music. Music is normalized and ducked under the voice.",
      "anyOf": [
        {
          "const": false
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string"
            },
            "volume": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 3,
              "description": "1 = standard bed; 0.7 quieter, 1.4 louder."
            }
          }
        }
      ]
    },
    "clicks": {
      "type": "boolean",
      "description": "A soft tick on each click in the recordings. Default false: a launch video has music, not mouse sounds."
    },
    "captions": {
      "type": "boolean",
      "description": "Burned-in captions from the narration. Default true."
    },
    "fps": {
      "enum": [
        24,
        30,
        60
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 320,
      "maximum": 3840
    },
    "height": {
      "type": "integer",
      "minimum": 240,
      "maximum": 2160
    },
    "output": {
      "type": "string",
      "description": "Output mp4 path, relative to this file. Default: <name>.mp4."
    },
    "style": {
      "type": "string",
      "description": "A style: fonts, colors, surfaces, radius, backdrop. A name (`ciak project styles` lists them: built-in hindsight, midnight, keynote, plus your own in ~/.ciak/styles) or a path to a style .json. \"theme\" overrides on top."
    }
  },
  "$defs": {
    "rich": {
      "type": "string",
      "description": "Text; *muted words* render grey, [accent words] in the accent color."
    },
    "stat": {
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "string",
            "number"
          ],
          "description": "Shown big; numbers in it count up, e.g. \"7.2M+\"."
        },
        "label": {
          "type": "string"
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "enum": [
            "dark",
            "light"
          ],
          "description": "Starting palette. Default dark."
        },
        "backdrop": {
          "enum": [
            "plain",
            "aurora",
            "grid"
          ],
          "description": "Animated background behind every scene. Default plain."
        },
        "background": {
          "type": "string",
          "description": "CSS background (color or gradient)."
        },
        "text": {
          "type": "string"
        },
        "muted": {
          "type": "string"
        },
        "accent": {
          "type": "string"
        },
        "accentText": {
          "type": "string",
          "description": "Text color on accent-colored pills."
        },
        "accentGradient": {
          "type": "string",
          "description": "CSS gradient for [accent] words."
        },
        "panel": {
          "type": "string"
        },
        "card": {
          "type": "string"
        },
        "glow": {
          "type": "string",
          "description": "Second aurora color."
        },
        "glow2": {
          "type": "string",
          "description": "Third aurora color."
        },
        "font": {
          "description": "Body font (CSS font-family).",
          "type": "string"
        },
        "headingFont": {
          "description": "Headline font.",
          "type": "string"
        },
        "monoFont": {
          "description": "Code font.",
          "type": "string"
        },
        "fontUrl": {
          "description": "Stylesheet that loads the fonts (e.g. Google Fonts).",
          "type": "string"
        },
        "border": {
          "description": "Card border color.",
          "type": "string"
        },
        "radius": {
          "description": "Corner radius of cards.",
          "type": "number"
        },
        "cardShadow": {
          "type": [
            "object",
            "null"
          ],
          "description": "Card glow: {dx, dy, blur, color, opacity}."
        }
      }
    },
    "common": {
      "say": {
        "type": "string",
        "description": "What the narrator says in this scene; the scene stretches to fit it."
      },
      "duration": {
        "type": "number",
        "minimum": 0.5,
        "description": "Minimum seconds for the scene."
      },
      "background": {
        "type": "string",
        "description": "Footage (mp4/mov) or image behind the scene, darkened automatically."
      },
      "dim": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{2}$",
        "description": "Darkening over the background as hex alpha, default \"55\"."
      },
      "kicker": {
        "type": "string",
        "description": "Small label above the title."
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "type"
      ],
      "discriminator": "type",
      "oneOf": [
        {
          "$ref": "#/$defs/title"
        },
        {
          "$ref": "#/$defs/slide"
        },
        {
          "$ref": "#/$defs/image"
        },
        {
          "$ref": "#/$defs/stats"
        },
        {
          "$ref": "#/$defs/chart"
        },
        {
          "$ref": "#/$defs/lines"
        },
        {
          "$ref": "#/$defs/recording"
        },
        {
          "$ref": "#/$defs/compare"
        },
        {
          "$ref": "#/$defs/end"
        },
        {
          "$ref": "#/$defs/custom"
        }
      ]
    },
    "title": {
      "description": "A big headline, optionally over footage, with chips, a pill or a live counter.",
      "type": "object",
      "required": [
        "type",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "title"
        },
        "title": {
          "$ref": "#/$defs/rich"
        },
        "subtitle": {
          "type": "string"
        },
        "align": {
          "enum": [
            "center",
            "top"
          ]
        },
        "size": {
          "type": "number",
          "minimum": 30,
          "maximum": 200
        },
        "pill": {
          "$ref": "#/$defs/rich"
        },
        "chips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rich"
          },
          "description": "Pop-in chips; a check mark is added unless the chip is a question (ends with ?)."
        },
        "counter": {
          "type": "object",
          "required": [
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": [
                "number",
                "string"
              ]
            },
            "to": {
              "type": [
                "number",
                "string"
              ]
            },
            "label": {
              "type": "string"
            }
          }
        },
        "say": {
          "$ref": "#/$defs/common/say"
        },
        "duration": {
          "$ref": "#/$defs/common/duration"
        },
        "background": {
          "$ref": "#/$defs/common/background"
        },
        "dim": {
          "$ref": "#/$defs/common/dim"
        },
        "kicker": {
          "$ref": "#/$defs/common/kicker"
        }
      }
    },
    "slide": {
      "description": "Title and bullets that appear one by one, with an optional image on the right.",
      "type": "object",
      "required": [
        "type",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "slide"
        },
        "title": {
          "$ref": "#/$defs/rich"
        },
        "bullets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rich"
          }
        },
        "image": {
          "type": "string"
        },
        "say": {
          "$ref": "#/$defs/common/say"
        },
        "duration": {
          "$ref": "#/$defs/common/duration"
        },
        "background": {
          "$ref": "#/$defs/common/background"
        },
        "dim": {
          "$ref": "#/$defs/common/dim"
        },
        "kicker": {
          "$ref": "#/$defs/common/kicker"
        }
      }
    },
    "image": {
      "description": "One image (e.g. a screenshot), slowly pushing in, with an optional title.",
      "type": "object",
      "required": [
        "type",
        "image"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "image"
        },
        "image": {
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/rich"
        },
        "say": {
          "$ref": "#/$defs/common/say"
        },
        "duration": {
          "$ref": "#/$defs/common/duration"
        },
        "background": {
          "$ref": "#/$defs/common/background"
        },
        "dim": {
          "$ref": "#/$defs/common/dim"
        },
        "kicker": {
          "$ref": "#/$defs/common/kicker"
        }
      }
    },
    "stats": {
      "description": "Big numbers that count up. Over footage, one stat per scene reads best.",
      "type": "object",
      "required": [
        "type",
        "stats"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "stats"
        },
        "title": {
          "$ref": "#/$defs/rich"
        },
        "stats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stat"
          }
        },
        "note": {
          "type": "string",
          "description": "Small print under the stats (source, date)."
        },
        "say": {
          "$ref": "#/$defs/common/say"
        },
        "duration": {
          "$ref": "#/$defs/common/duration"
        },
        "background": {
          "$ref": "#/$defs/common/background"
        },
        "dim": {
          "$ref": "#/$defs/common/dim"
        },
        "kicker": {
          "$ref": "#/$defs/common/kicker"
        }
      }
    },
    "chart": {
      "description": "Bars that grow; highlight the one that matters.",
      "type": "object",
      "required": [
        "type",
        "title",
        "bars"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "chart"
        },
        "title": {
          "$ref": "#/$defs/rich"
        },
        "unit": {
          "type": "string"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "Decimals shown on bar values. Default 0."
        },
        "bars": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "highlight": {
                "type": "boolean"
              }
            }
          }
        },
        "note": {
          "type": "string",
          "description": "Small print under the chart (source, date)."
        },
        "say": {
          "$ref": "#/$defs/common/say"
        },
        "duration": {
          "$ref": "#/$defs/common/duration"
        },
        "background": {
          "$ref": "#/$defs/common/background"
        },
        "dim": {
          "$ref": "#/$defs/common/dim"
        },
        "kicker": {
          "$ref": "#/$defs/common/kicker"
        }
      }
    },
    "lines": {
      "description": "Line charts that draw themselves; one or more panels side by side.",
      "type": "object",
      "required": [
        "type",
        "title",
        "panels"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "lines"
        },
        "title": {
          "$ref": "#/$defs/rich"
        },
        "legend": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "color": {
                "type": "string"
              }
            }
          }
        },
        "panels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "x",
              "series"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "x": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string"
                }
              },
              "shared": {
                "type": "boolean",
                "description": "All series on one scale (otherwise each uses its own)."
              },
              "series": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "values"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "description": "One value per x label."
                    },
                    "label": {
                      "type": "string",
                      "description": "End label, e.g. \"5.3s\"."
                    },
                    "color": {
                      "type": "string"
                    },
                    "projectedFrom": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Index from which the line is dashed (projected)."
                    },
                    "top": {
                      "type": "number",
                      "description": "Value at the top of this series' scale."
                    }
                  }
                }
              },
              "footer": {
                "$ref": "#/$defs/rich"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "say": {
          "$ref": "#/$defs/common/say"
        },
        "duration": {
          "$ref": "#/$defs/common/duration"
        },
        "background": {
          "$ref": "#/$defs/common/background"
        },
        "dim": {
          "$ref": "#/$defs/common/dim"
        },
        "kicker": {
          "$ref": "#/$defs/common/kicker"
        }
      }
    },
    "recording": {
      "description": "A recording (browser, screen or terminal) with its zooms and cursor.",
      "type": "object",
      "required": [
        "type",
        "recording"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "recording"
        },
        "recording": {
          "type": "string",
          "description": "A recording project: its id (ciak project list), or the --name it was recorded with (newest wins)."
        },
        "title": {
          "$ref": "#/$defs/rich"
        },
        "label": {
          "type": "string",
          "description": "Small pill on top (when there is no title)."
        },
        "speed": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 4,
          "description": "Playback speed; zooms, cursor and click sounds follow."
        },
        "say": {
          "$ref": "#/$defs/common/say"
        },
        "duration": {
          "$ref": "#/$defs/common/duration"
        },
        "kicker": {
          "$ref": "#/$defs/common/kicker"
        }
      }
    },
    "compare": {
      "description": "Two recordings side by side, playing together (before vs after).",
      "type": "object",
      "required": [
        "type",
        "before",
        "after"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "compare"
        },
        "title": {
          "$ref": "#/$defs/rich"
        },
        "before": {
          "$ref": "#/$defs/side"
        },
        "after": {
          "$ref": "#/$defs/side"
        },
        "speed": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 4
        },
        "say": {
          "$ref": "#/$defs/common/say"
        },
        "duration": {
          "$ref": "#/$defs/common/duration"
        },
        "kicker": {
          "$ref": "#/$defs/common/kicker"
        }
      }
    },
    "side": {
      "type": "object",
      "required": [
        "recording"
      ],
      "additionalProperties": false,
      "properties": {
        "recording": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "end": {
      "description": "Closing card: columns with a title, kicker, text and stats, then buttons.",
      "type": "object",
      "required": [
        "type",
        "columns"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "end"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "$ref": "#/$defs/rich"
              },
              "kicker": {
                "type": "string"
              },
              "text": {
                "$ref": "#/$defs/rich"
              },
              "stats": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/stat"
                }
              }
            }
          }
        },
        "buttons": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string"
          },
          "description": "The last one is the filled, primary button."
        },
        "say": {
          "$ref": "#/$defs/common/say"
        },
        "duration": {
          "$ref": "#/$defs/common/duration"
        },
        "background": {
          "$ref": "#/$defs/common/background"
        },
        "dim": {
          "$ref": "#/$defs/common/dim"
        }
      }
    },
    "custom": {
      "description": "Any layout you want: a React component (default export) from the film's folder. Import building blocks from \"ciak\" (Rich, Heading, Pill, Counter, LinePanel, Recording, Text, appear, ease, font, plus Remotion's AbsoluteFill, Img, useCurrentFrame, interpolate, spring). It receives its props plus {theme, frames, reserve, recordings, images}; keep `reserve` px free at the bottom for captions; wrap readable text in <Text> so the layout check sees it.",
      "type": "object",
      "required": [
        "type",
        "component"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "custom"
        },
        "component": {
          "type": "string",
          "description": "Path to the .jsx file, relative to film.json, e.g. \"scenes/hero.jsx\"."
        },
        "props": {
          "type": "object",
          "description": "Anything; passed to the component as props."
        },
        "recordings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Recordings by name, e.g. {\"main\": \"terminal-calls\"}; the component gets props.recordings.main for <Recording>. The scene lasts at least as long as the longest."
        },
        "images": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Images by name, e.g. {\"logo\": \"logo.png\"}; the component gets props.images.logo (a URL)."
        },
        "speed": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 4,
          "description": "Playback speed of the recordings."
        },
        "say": {
          "$ref": "#/$defs/common/say"
        },
        "duration": {
          "$ref": "#/$defs/common/duration"
        },
        "background": {
          "$ref": "#/$defs/common/background"
        },
        "dim": {
          "$ref": "#/$defs/common/dim"
        }
      }
    }
  }
}